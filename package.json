{
  "name": "dsh-plugin-task-forge",
  "version": "0.2.0",
  "description": "dsh plugin: compile a rough need into a versioned open-source-style task book, relay it to any AI window, and make the handoff lossless with a read-back handshake; /forge /relay /ack /answer /forge-list.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "编排与界面",
      "blurb": "大白话 → 任务书 → 跨窗口无损交接（回读握手）",
      "entries": "`/forge`",
      "featured": true,
      "featuredOrder": 2,
      "featuredBlurb": "把大白话编译成任务书，跨窗口 AI 无损交接：回读握手逼出理解损耗，缺口闭环、版本号跨窗口唯一权威",
      "featuredEntries": "`/forge` `/relay` `/ack` `/answer` `/forge-list`"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "spec",
    "prompt",
    "handshake",
    "handoff",
    "workflow",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-task-forge.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "bugs": {
    "url": "https://github.com/121212165/dsh-plugin-task-forge/issues"
  },
  "icon": "./icon.svg"
}
